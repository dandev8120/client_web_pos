<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5984942">
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <BuildCommand>npm run build</BuildCommand>
    <CleanCommand>npm run clean</CleanCommand>
    <TestCommand>npm run lint</TestCommand>
    <LaunchJsonFolder>.vscode</LaunchJsonFolder>
    <ShouldRunNpmInstall>true</ShouldRunNpmInstall>
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
  </PropertyGroup>
</Project>
